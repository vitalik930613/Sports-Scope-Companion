<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 12+ : scan et connexion BLE. `neverForLocation` évite d'avoir à
         demander la localisation juste pour scanner — on ne géolocalise pas via
         le Bluetooth. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 et antérieurs : l'ancien modèle, où scanner exigeait la
         localisation fine. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- La navigation charge l'application web dans un WebView. Flutter ne
         déclare INTERNET que dans les manifestes debug et profile : sans cette
         ligne, la version release afficherait une page blanche. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Position, pour trois usages : la géolocalisation de la page de
         navigation (toutes versions d'Android), l'enregistrement des sorties, et
         le scan BLE sur Android 11 et antérieurs. Une seule déclaration, sans
         `maxSdkVersion` : le même manifeste ne peut pas porter deux fois la même
         permission, et c'est la navigation qui impose la portée la plus large. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Enregistrement d'une sortie : la localisation tourne dans un service au
         premier plan (geolocator), sans quoi Android gèlerait le processus dès
         l'écran éteint — une sortie de trois heures se réduirait à ses premières
         minutes. Le service est démarré alors que l'appli est à l'écran, ce qui
         dispense d'ACCESS_BACKGROUND_LOCATION (« autoriser tout le temps ») : on
         ne démarre jamais la localisation depuis l'arrière-plan. WAKE_LOCK garde
         le processeur éveillé entre deux trames, faute de quoi les notifications
         BLE arriveraient par paquets au réveil. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+ : sans elle la notification du service existe mais reste
         invisible — le témoin « enregistrement en cours » disparaîtrait. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Sports Scope Companion"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- « Ouvrir dans l'appli » depuis le site : sportsscope://navigate/<token>.
                 Schéma propre à l'appli, donc rien à publier côté serveur et
                 fonctionne avec une signature de debug. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sportsscope" android:host="navigate"/>
            </intent-filter>

            <!-- App Link sur l'URL réelle : un lien d'itinéraire partagé ouvre
                 directement la navigation dans l'appli, depuis n'importe où.
                 Inactif tant que https://sports.logicraft.ch/.well-known/assetlinks.json
                 ne publie pas l'empreinte SHA-256 de la clé de signature — d'ici
                 là Android se contente d'ouvrir le navigateur. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="sports.logicraft.ch"
                    android:pathPattern="/routes/.*/navigate"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
